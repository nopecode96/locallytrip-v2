generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SequelizeMeta {
  name String @id @db.VarChar(255)
}

model affiliate_applications {
  id                                              Int                    @id @default(autoincrement())
  user_id                                         Int
  status                                          String                 @default("pending") @db.VarChar(50)
  submitted_at                                    DateTime?              @db.Timestamptz(6)
  reviewed_at                                     DateTime?              @db.Timestamptz(6)
  reviewed_by                                     Int?
  approval_notes                                  String?
  rejection_reason                                String?
  full_name                                       String                 @db.VarChar(255)
  email                                           String                 @db.VarChar(255)
  phone                                           String?                @db.VarChar(50)
  date_of_birth                                   DateTime?              @db.Date
  nationality                                     String?                @db.VarChar(100)
  current_city                                    String?                @db.VarChar(255)
  current_country                                 String?                @db.VarChar(100)
  identity_type                                   String?                @db.VarChar(50)
  identity_number                                 String?                @db.VarChar(100)
  identity_expiry_date                            DateTime?              @db.Date
  identity_document_url                           String?                @db.VarChar(500)
  business_name                                   String?                @db.VarChar(255)
  business_type                                   String?                @db.VarChar(100)
  years_of_experience                             Int?                   @default(0)
  specialization                                  String?
  languages_spoken                                String[]
  certifications                                  String?
  portfolio_website                               String?                @db.VarChar(500)
  instagram_handle                                String?                @db.VarChar(255)
  instagram_followers                             Int?                   @default(0)
  facebook_page                                   String?                @db.VarChar(500)
  facebook_followers                              Int?                   @default(0)
  tiktok_handle                                   String?                @db.VarChar(255)
  tiktok_followers                                Int?                   @default(0)
  youtube_channel                                 String?                @db.VarChar(500)
  youtube_subscribers                             Int?                   @default(0)
  other_social_platforms                          String?
  content_creation_experience                     String?
  travel_content_examples                         String?
  photography_equipment                           String?
  video_equipment                                 String?
  editing_software                                String?
  marketing_strategy                              String?
  target_audience                                 String?
  promotion_channels                              String?
  expected_monthly_referrals                      Int?                   @default(0)
  bank_name                                       String?                @db.VarChar(255)
  bank_account_number                             String?                @db.VarChar(100)
  bank_account_holder                             String?                @db.VarChar(255)
  tax_id                                          String?                @db.VarChar(100)
  preferred_payment_method                        String?                @default("bank_transfer") @db.VarChar(100)
  motivation                                      String?
  goals                                           String?
  why_locallytrip                                 String?
  additional_comments                             String?
  total_social_followers                          Int?                   @default(0)
  calculated_tier                                 String?                @default("micro_1") @db.VarChar(50)
  application_score                               Decimal?               @default(0) @db.Decimal(5, 2)
  terms_agreed                                    Boolean?               @default(false)
  privacy_agreed                                  Boolean?               @default(false)
  marketing_consent                               Boolean?               @default(false)
  ip_address                                      String?                @db.Inet
  user_agent                                      String?
  referral_source                                 String?                @db.VarChar(255)
  created_at                                      DateTime               @db.Timestamptz(6)
  updated_at                                      DateTime               @db.Timestamptz(6)
  users_affiliate_applications_reviewed_byTousers users?                 @relation("affiliate_applications_reviewed_byTousers", fields: [reviewed_by], references: [id])
  users_affiliate_applications_user_idTousers     users                  @relation("affiliate_applications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)
  affiliate_audit_logs                            affiliate_audit_logs[]
}

model affiliate_audit_logs {
  id                                             Int                                   @id @default(autoincrement())
  application_id                                 Int
  user_id                                        Int
  action                                         String                                @db.VarChar(100)
  action_type                                    enum_affiliate_audit_logs_action_type
  old_status                                     String?                               @db.VarChar(50)
  new_status                                     String?                               @db.VarChar(50)
  old_values                                     Json?                                 @db.Json
  new_values                                     Json?                                 @db.Json
  changes_summary                                String?
  performed_by                                   Int?
  performed_by_role                              String?                               @db.VarChar(50)
  notes                                          String?
  reason                                         String?
  admin_comments                                 String?
  ip_address                                     String?                               @db.VarChar(45)
  user_agent                                     String?
  session_id                                     String?                               @db.VarChar(255)
  request_id                                     String?                               @db.VarChar(255)
  api_endpoint                                   String?                               @db.VarChar(255)
  request_method                                 String?                               @db.VarChar(10)
  request_headers                                Json?                                 @db.Json
  response_status                                Int?
  created_at                                     DateTime                              @db.Timestamptz(6)
  affiliate_applications                         affiliate_applications                @relation(fields: [application_id], references: [id], onDelete: Cascade)
  users_affiliate_audit_logs_performed_byTousers users?                                @relation("affiliate_audit_logs_performed_byTousers", fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_affiliate_audit_logs_user_idTousers      users                                 @relation("affiliate_audit_logs_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([action_type], map: "affiliate_audit_logs_action_type")
  @@index([application_id], map: "affiliate_audit_logs_application_id")
  @@index([application_id, action_type, created_at], map: "affiliate_audit_logs_application_id_action_type_created_at")
  @@index([created_at], map: "affiliate_audit_logs_created_at")
  @@index([performed_by], map: "affiliate_audit_logs_performed_by")
  @@index([user_id], map: "affiliate_audit_logs_user_id")
}

model affiliate_programs {
  id                      Int                            @id @default(autoincrement())
  user_id                 Int
  affiliate_code          String                         @unique @db.VarChar(50)
  commission_rate         Decimal                        @default(7) @db.Decimal(5, 2)
  tier                    enum_affiliate_programs_tier   @default(micro_1)
  status                  enum_affiliate_programs_status @default(pending)
  total_bookings          Int                            @default(0)
  total_earnings          Decimal                        @default(0) @db.Decimal(12, 2)
  preferred_currency      String                         @default("USD") @db.VarChar(3)
  payout_threshold        Decimal                        @default(50) @db.Decimal(10, 2)
  payout_method           String?                        @default("paypal") @db.VarChar(50)
  payout_details          Json?                          @default("{}")
  notes                   String?
  activated_at            DateTime?                      @db.Timestamptz(6)
  last_payout_at          DateTime?                      @db.Timestamptz(6)
  created_at              DateTime                       @db.Timestamptz(6)
  updated_at              DateTime                       @db.Timestamptz(6)
  users                   users                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  commission_transactions commission_transactions[]

  @@index([affiliate_code], map: "affiliate_programs_affiliate_code")
  @@index([status], map: "affiliate_programs_status")
  @@index([tier], map: "affiliate_programs_tier")
  @@index([user_id], map: "affiliate_programs_user_id")
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(100)
  entity_id   Int?
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id])

  @@index([created_at], map: "audit_logs_created_at")
  @@index([entity_type, entity_id], map: "audit_logs_entity_type_entity_id")
  @@index([user_id], map: "audit_logs_user_id")
}

model banks {
  id                 Int                  @id @default(autoincrement())
  bank_code          String               @unique @db.VarChar(10)
  bank_name          String               @db.VarChar(100)
  bank_name_short    String?              @db.VarChar(50)
  swift_code         String?              @db.VarChar(11)
  country_code       String?              @default("ID") @db.VarChar(2)
  logo_url           String?              @db.VarChar(255)
  is_active          Boolean?             @default(true)
  created_at         DateTime             @db.Timestamptz(6)
  updated_at         DateTime             @db.Timestamptz(6)
  user_bank_accounts user_bank_accounts[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model banner_clicks {
  id         Int      @id @default(autoincrement())
  banner_id  Int
  user_id    Int?
  clicked_at DateTime @db.Timestamptz(6)
  referrer   String?
  ip_address String?  @db.VarChar(45)
  banners    banners  @relation(fields: [banner_id], references: [id], onDelete: Cascade)
  users      users?   @relation(fields: [user_id], references: [id])

  @@index([banner_id], map: "idx_banner_clicks_banner_id")
  @@index([banner_id, clicked_at], map: "idx_banner_clicks_reporting")
  @@index([clicked_at], map: "idx_banner_clicks_timestamp")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model banners {
  id                 Int               @id @default(autoincrement())
  uuid               String            @unique @db.Uuid
  title              String            @db.VarChar(200)
  client_name        String            @db.VarChar(200)
  contract_reference String?           @db.VarChar(100)
  image_sizes        Json
  link_url           String            @db.VarChar(500)
  placement_page     String            @db.VarChar(50)
  tier               enum_banners_tier @default(regular)
  rotation_weight    Int               @default(1)
  is_active          Boolean           @default(true)
  start_date         DateTime          @db.Timestamptz(6)
  end_date           DateTime          @db.Timestamptz(6)
  impression_count   Int               @default(0)
  click_count        Int               @default(0)
  notes              String?
  created_by         Int?
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)
  banner_clicks      banner_clicks[]
  users              users?            @relation(fields: [created_by], references: [id])

  @@index([placement_page, tier, is_active, start_date, end_date], map: "idx_banners_active_lookup")
  @@index([client_name], map: "idx_banners_client_name")
  @@index([start_date, end_date], map: "idx_banners_date_range")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bookings {
  id                      Int                       @id @default(autoincrement())
  uuid                    String?                   @unique @db.Uuid
  experience_id           Int?
  user_id                 Int?
  selected_date           DateTime?                 @db.Date
  selected_time           DateTime?                 @db.Time(6)
  participant_count       Int?                      @default(1)
  quantity                Int                       @default(1)
  total_price             Decimal                   @default(0) @db.Decimal(10, 2)
  status                  String?                   @default("pending") @db.VarChar(20)
  special_requests        String?
  contact_info            Json?
  cancellation_reason     String?
  booking_reference       String?                   @unique @db.VarChar(50)
  category_specific       Json?
  participants            Json?
  created_at              DateTime                  @db.Timestamptz(6)
  updated_at              DateTime                  @db.Timestamptz(6)
  paypal_order_id         String?                   @db.VarChar(100)
  experiences             experiences?              @relation(fields: [experience_id], references: [id])
  users                   users?                    @relation(fields: [user_id], references: [id])
  commission_transactions commission_transactions[]
  payments                payments[]
  promo_code_usage        promo_code_usage[]
  reviews                 reviews?
}

model cities {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  country_id           Int?
  latitude             Decimal?               @db.Decimal(10, 8)
  longitude            Decimal?               @db.Decimal(11, 8)
  description          String?
  image_url            String?                @db.VarChar(500)
  is_active            Boolean?               @default(true)
  created_at           DateTime               @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  countries            countries?             @relation(fields: [country_id], references: [id])
  experiences          experiences[]
  featured_cities      featured_cities[]
  stories              stories[]
  users                users[]
  vibes_travel_meetups vibes_travel_meetups[]
}

model commission_settings {
  id                           Int      @id @default(autoincrement())
  service_fee_percent          Decimal  @default(10) @db.Decimal(5, 2)
  host_commission_percent      Decimal  @default(15) @db.Decimal(5, 2)
  affiliate_commission_percent Decimal  @default(5) @db.Decimal(5, 2)
  referral_commission_percent  Decimal  @default(5) @db.Decimal(5, 2)
  min_booking_amount           Decimal  @default(10) @db.Decimal(10, 2)
  max_discount_percent         Decimal  @default(50) @db.Decimal(5, 2)
  max_stacked_codes            Int      @default(3)
  platform_currency            String   @default("USD") @db.VarChar(3)
  updated_by                   Int?
  created_at                   DateTime @db.Timestamptz(6)
  updated_at                   DateTime @db.Timestamptz(6)
  users                        users?   @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model commission_transactions {
  id                  Int                                          @id @default(autoincrement())
  booking_id          Int
  affiliate_id        Int?
  referrer_user_id    Int?
  referral_code_used  String?                                      @db.VarChar(50)
  commission_type     enum_commission_transactions_commission_type
  base_amount         Decimal                                      @db.Decimal(12, 2)
  base_currency       String                                       @db.VarChar(3)
  commission_amount   Decimal                                      @db.Decimal(12, 2)
  commission_rate     Decimal                                      @db.Decimal(5, 2)
  payout_amount       Decimal?                                     @db.Decimal(12, 2)
  payout_currency     String?                                      @db.VarChar(3)
  exchange_rate       Decimal?                                     @db.Decimal(10, 6)
  rate_date           DateTime?                                    @db.Timestamptz(6)
  status              enum_commission_transactions_status          @default(pending)
  processed_at        DateTime?                                    @db.Timestamptz(6)
  payout_method       String?                                      @db.VarChar(50)
  payout_reference    String?                                      @db.VarChar(100)
  payout_fee          Decimal?                                     @default(0) @db.Decimal(10, 2)
  calculation_details Json?                                        @default("{}")
  notes               String?
  created_at          DateTime                                     @db.Timestamptz(6)
  updated_at          DateTime                                     @db.Timestamptz(6)
  affiliate_programs  affiliate_programs?                          @relation(fields: [affiliate_id], references: [id])
  bookings            bookings                                     @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  users               users?                                       @relation(fields: [referrer_user_id], references: [id], onUpdate: NoAction)

  @@index([affiliate_id], map: "commission_transactions_affiliate_id")
  @@index([base_currency], map: "commission_transactions_base_currency")
  @@index([booking_id], map: "commission_transactions_booking_id")
  @@index([commission_type], map: "commission_transactions_commission_type")
  @@index([payout_currency], map: "commission_transactions_payout_currency")
  @@index([processed_at], map: "commission_transactions_processed_at")
  @@index([status], map: "commission_transactions_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model communication_apps {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @unique @db.VarChar(50)
  display_name                String                        @db.VarChar(100)
  icon_url                    String?                       @db.VarChar(255)
  url_pattern                 String?                       @db.VarChar(255)
  is_active                   Boolean?                      @default(true)
  sort_order                  Int?                          @default(0)
  created_at                  DateTime                      @db.Timestamptz(6)
  updated_at                  DateTime                      @db.Timestamptz(6)
  user_communication_contacts user_communication_contacts[]
}

model conversation_participants {
  id              Int           @id @default(autoincrement())
  conversation_id Int
  user_id         Int
  last_read_at    DateTime?     @db.Timestamptz(6)
  unread_count    Int?          @default(0)
  is_archived     Boolean?      @default(false)
  is_muted        Boolean?      @default(false)
  joined_at       DateTime?     @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction)
}

model conversations {
  id                                         Int                         @id @default(autoincrement())
  participant1_id                            Int
  participant2_id                            Int
  last_message_at                            DateTime?                   @db.Timestamptz(6)
  created_at                                 DateTime                    @db.Timestamptz(6)
  updated_at                                 DateTime                    @db.Timestamptz(6)
  conversation_participants                  conversation_participants[]
  users_conversations_participant1_idTousers users                       @relation("conversations_participant1_idTousers", fields: [participant1_id], references: [id], onDelete: NoAction)
  users_conversations_participant2_idTousers users                       @relation("conversations_participant2_idTousers", fields: [participant2_id], references: [id], onDelete: NoAction)
  messages                                   messages[]
}

model countries {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  code       String   @unique @db.VarChar(3)
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  cities     cities[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model currency_rates {
  id            Int       @id @default(autoincrement())
  from_currency String    @db.VarChar(3)
  to_currency   String    @db.VarChar(3)
  rate          Decimal   @db.Decimal(12, 6)
  source        String?   @default("manual") @db.VarChar(50)
  rate_date     DateTime? @db.Date
  is_active     Boolean?  @default(true)
  created_at    DateTime  @db.Timestamptz(6)
  updated_at    DateTime  @db.Timestamptz(6)
  expires_at    DateTime? @db.Timestamptz(6)

  @@unique([from_currency, to_currency, rate_date], map: "currency_rates_from_currency_to_currency_rate_date")
  @@index([expires_at], map: "currency_rates_expires_at")
  @@index([from_currency, to_currency], map: "currency_rates_from_currency_to_currency")
  @@index([is_active], map: "currency_rates_is_active")
  @@index([rate_date], map: "currency_rates_rate_date")
  @@index([updated_at], map: "currency_rates_updated_at")
}

model experience_itineraries {
  id               Int          @id @default(autoincrement())
  experience_id    Int?
  step_order       Int
  title            String       @db.VarChar(200)
  description      String?
  duration_minutes Int?
  location         String?      @db.VarChar(255)
  created_at       DateTime     @db.Timestamptz(6)
  updated_at       DateTime     @db.Timestamptz(6)
  experiences      experiences? @relation(fields: [experience_id], references: [id])

  @@index([experience_id, step_order], map: "experience_itineraries_experience_id_step_order")
}

model experience_shares {
  id            Int         @id @default(autoincrement())
  experience_id Int
