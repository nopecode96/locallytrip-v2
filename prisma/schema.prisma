  @@index([experience_id], map: "experience_shares_experience_id")
  @@index([share_type], map: "experience_shares_share_type")
  @@index([shared_at], map: "experience_shares_shared_at")
  @@index([user_id], map: "experience_shares_user_id")
}

model experience_types {
