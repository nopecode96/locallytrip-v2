model reward_system_settings {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique @db.VarChar(100)
  setting_value String   @db.VarChar(255)
  description   String?  @db.Text
  updated_at    DateTime @default(now()) @updatedAt
}

model reward_level_tiers {
  level                 Int      @id
  name_id               String   @db.VarChar(100)
  name_en               String   @db.VarChar(100)
  min_xp                Int
  badge_icon            String   @db.VarChar(50)
  ltp_bonus             Int      @default(0)
  reward_type           String   @default("NONE") @db.VarChar(50)
  reward_title_id       String?  @db.VarChar(255)
  reward_title_en       String?  @db.VarChar(255)
  reward_description_id String?  @db.Text
  reward_description_en String?  @db.Text
  claim_required        Boolean  @default(false)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
}

model reward_action_rules {
  id             Int      @id @default(autoincrement())
  action_code    String   @unique @db.VarChar(100)
  category       String   @db.VarChar(50)
  name_id        String   @db.VarChar(150)
  name_en        String   @db.VarChar(150)
  description_id String?  @db.Text
  description_en String?  @db.Text
  xp_reward      Int      @default(0)
  ltp_reward     Int      @default(0)
  max_frequency  String   @default("UNLIMITED") @db.VarChar(50)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
}

model user_reward_claims {
  id               Int       @id @default(autoincrement())
  user_id          Int
  level            Int
  reward_type      String    @db.VarChar(50)
  reward_title     String    @db.VarChar(255)
  status           String    @default("PENDING") @db.VarChar(50) // PENDING, PROCESSING, SHIPPED, COMPLETED
  shipping_address Json?
  tracking_number  String?   @db.VarChar(100)
  voucher_code     String?   @db.VarChar(100)
  claimed_at       DateTime  @default(now())
  fulfilled_at     DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// 1. Profil Mitra Brand
model brand_partners {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(150)
  slug            String            @unique @db.VarChar(150)
  category        String            @db.VarChar(50) // 'HOSPITALITY', 'OUTDOOR_GEAR', 'FNB', 'TRANSPORT', 'INSURANCE'
  logo_url        String            @db.VarChar(500)
  banner_url      String?           @db.VarChar(500)
  website_url     String?           @db.VarChar(255)
  contact_person  String            @db.VarChar(100)
  contact_email   String            @db.VarChar(150)
  contact_phone   String            @db.VarChar(50)
  description     String?           @db.Text
  status          String            @default("PENDING") @db.VarChar(30) // 'PENDING', 'APPROVED', 'ACTIVE', 'PAUSED', 'REJECTED'
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt

  campaigns       brand_campaigns[]
}

// 2. Kampanye Promosi / Penawaran Voucher Brand
model brand_campaigns {
  id              Int                   @id @default(autoincrement())
  partner_id      Int
  title           String                @db.VarChar(255)
  slug            String                @unique @db.VarChar(255)
  description     String                @db.Text
  terms           String?               @db.Text
  image_url       String                @db.VarChar(500)
  
  // Paket Tier Promosi (Hybrid: Barter vs Berbayar)
  tier_package    String                @default("COMMUNITY_BARTER") // 'COMMUNITY_BARTER', 'FEATURED_PARTNER', 'PREMIUM_SPONSOR'
  placement_fee   Decimal               @default(0) @db.Decimal(12, 2)
  payment_status  String                @default("WAIVED_BARTER") // 'UNPAID', 'PAID', 'WAIVED_BARTER'
  is_featured     Boolean               @default(false)
  
  // Persyaratan Klaim User
  cost_in_ltp     Int                   @default(0)     // Jumlah LTP yang ditukarkan (0 jika gratis)
  min_xp_level    Int                   @default(1)     // Batas minimum level XP pengguna
  
  // Kuota & Masa Berlaku
  total_quota     Int                   @default(100)
  claimed_quota   Int                   @default(0)
  start_date      DateTime              @default(now())
  end_date        DateTime
  is_active       Boolean               @default(true)
  created_at      DateTime              @default(now())

  partner         brand_partners        @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  vouchers        brand_voucher_codes[]
  claims          user_brand_claims[]
}

// 3. Pool Kode Voucher Unik yang Disetor Brand
model brand_voucher_codes {
  id                  Int             @id @default(autoincrement())
  campaign_id         Int
  code                String          @db.VarChar(100)
  is_claimed          Boolean         @default(false)
  claimed_at          DateTime?
  claimed_by_user_id  Int?

  campaign            brand_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
}

// 4. Riwayat Klaim Voucher oleh Pengguna
model user_brand_claims {
  id              Int             @id @default(autoincrement())
  user_id         Int
  campaign_id     Int
  voucher_code    String          @db.VarChar(100)
  ltp_spent       Int             @default(0)
  status          String          @default("ACTIVE") @db.VarChar(30) // 'ACTIVE', 'USED', 'EXPIRED'
  claimed_at      DateTime        @default(now())
  used_at         DateTime?

  campaign        brand_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  user            users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// 5. Laporan Konten Komunitas (Reports to Admin)
model content_reports {
  id          Int      @id @default(autoincrement())
  target_type String   @db.VarChar(50) // 'forum_thread', 'forum_post', 'story', 'meetup'
  target_id   Int      // ID of the reported thread, post, or story
  reporter_id Int      // User ID who submitted the report
  reason      String   @db.VarChar(255) // Reason category (spam, hate_speech, inappropriate, copyright, harassment)
  description String?
  status      String   @default("pending") @db.VarChar(50) // pending, reviewed, resolved, dismissed
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  reporter    users    @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([target_type, target_id], map: "idx_content_reports_target")
  @@index([reporter_id], map: "idx_content_reports_reporter")
  @@index([status], map: "idx_content_reports_status")
}

