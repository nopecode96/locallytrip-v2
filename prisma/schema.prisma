  @@index([user_id], map: "experience_views_user_id")
  @@index([viewed_at], map: "experience_views_viewed_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model experiences {
  id                          Int                      @id @default(autoincrement())
  uuid                        String?                  @unique @db.Uuid
  title                       String                   @db.VarChar(500)
  title_id                    String?                  @db.VarChar(500)
  title_en                    String?                  @db.VarChar(500)
  slug                        String?                  @unique @db.VarChar(255)
  description                 String
  description_id              String?
  description_en              String?
  short_description           String?                  @db.VarChar(500)
  what_to_expect              Json?
  requirements                Json?
  host_id                     Int?
  category_id                 Int?
  experience_type_id          Int?
  city_id                     Int?
  package_price               Decimal?                 @db.Decimal(10, 2)
  currency                    String?                  @default("USD") @db.VarChar(3)
  duration_hours              Int?                     @default(4)
  max_participants            Int?                     @default(10)
  min_participants            Int?                     @default(1)
  difficulty_level            String?                  @db.VarChar(20)
  images                      Json?
  included_items              Json?
  excluded_items              Json?
  meeting_point               String?
  latitude                    Decimal?                 @db.Decimal(10, 8)
  longitude                   Decimal?                 @db.Decimal(11, 8)
  status                      enum_experiences_status  @default(draft)
  is_active                   Boolean?                 @default(true)
  is_featured                 Boolean?                 @default(false)
  rating_average              Decimal?                 @default(0) @db.Decimal(3, 2)
  rating_count                Int?                     @default(0)
